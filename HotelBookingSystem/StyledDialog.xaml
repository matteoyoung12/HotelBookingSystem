<Window x:Class="HotelsManager.StyledDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MinHeight="250"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="18" BorderBrush="#DCE7F8" BorderThickness="1" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.22" Color="#0F2744" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="IconCircle" Width="38" Height="38" CornerRadius="19" Background="#EAF1FF">
                    <TextBlock x:Name="IconText" Text="i" FontSize="20" FontWeight="Bold" Foreground="#075CFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="Сообщение" FontSize="19" FontWeight="SemiBold" Foreground="#172554" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Foreground="#52657C" FontSize="14" LineHeight="21" Margin="0,21,0,25" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Отмена" Padding="17,9" Margin="0,0,10,0" Click="Cancel_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="#EEF3FA" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                    <Button.Foreground>#334155</Button.Foreground>
                </Button>
                <Button x:Name="ConfirmButton" Content="Понятно" Padding="18,9" Foreground="White" Click="Confirm_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ActionBorder" Background="#075CFF" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="#0647C9" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
