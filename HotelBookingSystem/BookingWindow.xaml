<Window x:Class="HotelsManager.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новое бронирование" Width="690" Height="695" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
        <Style x:Key="InputStyle" TargetType="TextBox"><Setter Property="Padding" Value="11,8" /><Setter Property="BorderBrush" Value="#D7E0EF" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="PrimaryAction" TargetType="Button"><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="20,11" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionBorder" Background="#075CFF" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="#0647C9" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="LightAction" TargetType="Button"><Setter Property="Foreground" Value="#334155" /><Setter Property="Padding" Value="18,11" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="#E8EFF9" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="#102A43" CornerRadius="16" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="13" Background="#2374FF"><TextBlock Text="⌂" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Новое бронирование" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Заполните данные гостя и выберите подходящий тариф" Foreground="#C4D5ED" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="#E2EAF5" BorderThickness="1" Padding="22" Margin="0,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Номер" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="RoomCombo" DisplayMemberPath="BookingDisplay" SelectionChanged="BookingValueChanged" Padding="8" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Имя гостя" Style="{StaticResource LabelStyle}" /><TextBox x:Name="GuestNameBox" Style="{StaticResource InputStyle}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Email для уведомлений" Style="{StaticResource LabelStyle}" /><TextBox x:Name="GuestEmailBox" Style="{StaticResource InputStyle}" /></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Дата заезда" Style="{StaticResource LabelStyle}" /><DatePicker x:Name="CheckInPicker" SelectedDateChanged="BookingValueChanged" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Дата выезда" Style="{StaticResource LabelStyle}" /><DatePicker x:Name="CheckOutPicker" SelectedDateChanged="BookingValueChanged" /></StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="Тариф" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="StrategyCombo" DisplayMemberPath="Name" SelectionChanged="BookingValueChanged" Padding="8" />
                </StackPanel>
                <Border Grid.Row="4" Background="#EDF5FF" CornerRadius="12" Padding="16" Margin="0,17,0,0" VerticalAlignment="Top">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Итоговая стоимость" Foreground="#476892" FontSize="12" /><TextBlock x:Name="HintText" Text="Выберите номер, даты и тариф" Foreground="#476892" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                    <TextBlock x:Name="TotalText" Grid.Column="1" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="#075CFF" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource LightAction}" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="Забронировать" Style="{StaticResource PrimaryAction}" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
